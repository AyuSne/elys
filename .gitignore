# Unity 生成目录（不带前导斜杠，任何深度的同名目录都会匹配）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Ss]creenshots/

# Unity 自动生成的解决方案与工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Unity 自动生成的 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Addressables 打包中间产物
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# 崩溃报告
crashlytics-build.properties

# 编辑器与系统
.idea/
.vs/
.vscode/
.DS_Store
Thumbs.db

# 本地密钥 —— 绝不入库
.secrets.local.json
.env
*.env.local

# 测试报告：生成物，不入库
/test-results.xml
/TestResults/
